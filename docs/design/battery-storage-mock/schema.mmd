erDiagram
    employees ||..o{ employee_credentials : "employee_id"
    cabinets ||..o{ shelves : "cabinet_id"
    shelves ||..o{ cells : "shelf_id"
    cells o|..o| batteries : "current_cell_id"
    employees o|..o{ batteries : "current_holder_employee_id"
    batteries ||..o{ battery_operations : "battery_id"
    employees ||..o{ battery_operations : "actor_employee_id"
    employee_credentials ||..o{ battery_operations : "credential_id"
    cells o|..o{ battery_operations : "source_cell_id"
    cells o|..o{ battery_operations : "destination_cell_id"
    employees o|..o{ battery_operations : "previous_holder_employee_id"
    employees o|..o{ battery_operations : "new_holder_employee_id"

    employees {
        uuid id PK
        text name
        timestamptz created_at
        timestamptz disabled_at
    }

    employee_credentials {
        uuid id PK
        uuid employee_id FK
        text value UK
        timestamptz created_at
        timestamptz revoked_at
    }

    cabinets {
        uuid id PK
        integer number UK
        timestamptz created_at
        timestamptz disabled_at
    }

    shelves {
        uuid id PK
        uuid cabinet_id FK
        integer number
        timestamptz created_at
        timestamptz disabled_at
    }

    cells {
        uuid id PK
        uuid shelf_id FK
        integer number
        timestamptz created_at
        timestamptz disabled_at
    }

    batteries {
        uuid id PK
        text inventory_code UK
        text status
        uuid current_cell_id FK, UK
        uuid current_holder_employee_id FK
        integer version
        timestamptz created_at
        timestamptz updated_at
    }

    battery_operations {
        uuid id PK
        uuid battery_id FK
        integer battery_version
        text type
        uuid actor_employee_id FK
        uuid credential_id FK
        text device_code
        uuid source_cell_id FK
        uuid destination_cell_id FK
        uuid previous_holder_employee_id FK
        uuid new_holder_employee_id FK
        timestamptz recorded_at
    }

